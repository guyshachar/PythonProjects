{
  "$id": "https://cheerapp.example/schema/show.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheerApp Show",
  "description": "A published timeline of synchronized cues for one Event. See cheerApp/docs/SHOW_FORMAT.md for the narrative version.",
  "type": "object",
  "required": ["showId", "eventId", "startAtUtc", "cues"],
  "properties": {
    "schemaVersion": { "const": "v1" },
    "showId": { "type": "string" },
    "eventId": { "type": "string" },
    "startAtUtc": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC instant every cue's offsetMs is relative to."
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assetId", "type", "url"],
        "properties": {
          "assetId": { "type": "string" },
          "type": { "enum": ["image", "video", "audio"] },
          "url": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "description": "optional integrity check for cached assets" }
        }
      }
    },
    "cues": {
      "type": "array",
      "items": { "$ref": "#/$defs/cue" }
    }
  },
  "$defs": {
    "cue": {
      "type": "object",
      "required": ["id", "offsetMs", "durationMs", "type", "params", "zones"],
      "properties": {
        "id": { "type": "string" },
        "offsetMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds after startAtUtc this cue's absolute fire instant falls at."
        },
        "durationMs": { "type": "integer", "minimum": 0 },
        "type": { "enum": ["flash", "color", "image", "video", "audio"] },
        "zones": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Zone ids this cue is scoped to, or [\"ALL\"] for the whole venue."
        },
        "params": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "flash" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["frequencyHz"],
                "properties": { "frequencyHz": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 } }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "color" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["hex"],
                "properties": { "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "enum": ["image", "video"] } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["assetId"],
                "properties": { "assetId": { "type": "string" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "audio" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["assetId"],
                "properties": {
                  "assetId": { "type": "string" },
                  "volume": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            }
          }
        }
      ]
    }
  }
}
