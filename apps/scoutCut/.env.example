# Copy this file to .env and fill in values

# Infrastructure
REDIS_URL=redis://localhost:6379/0
# Docker: SQLite lives in the named 'data' volume so it survives image rebuilds
DATABASE_URL=sqlite:////app/data/scoutcut.db
# Local dev (outside Docker): uncomment the line below instead
# DATABASE_URL=sqlite:///./scoutcut.db

# Email delivery (choose one)
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# SMTP_FROM=noreply@scoutcut.app

# SendGrid alternative
# SENDGRID_API_KEY=SG.xxxxx

# WhatsApp delivery via Twilio
# TWILIO_ACCOUNT_SID=ACxxxxx
# TWILIO_AUTH_TOKEN=xxxxx
# TWILIO_WHATSAPP_FROM=+14155238886

# Google Drive upload (scoutCut uses credentials.json / token.json directly)
# These are read by scoutCut.py — place credentials.json in the project root
