                "BROWSER_VIEWPORT_HEIGHT": "720",
                "avoidChatGroups": "False",
                "skipCollectItemsForAssigner1": "True",
                "logDynamoDb": "False",
                "loadInterval": "300",
                "latencyFactor": "1.0",
                "skipLoginOnHold": "True",
                "filteredTenantKeys1": "IL#football#2025-26",
                "filteredTenantKeys2": "IL#handball#2025-26",
                "filteredTenantKeys3": "IL#handball#2025-26,IL#football#2025-26",
                "filteredMobileNos0": "+972546225414,+972522899253",
                "filteredMobileNos1": "+972522899253", //חכמון
                "filteredMobileNos3": "+972506360689", //שיכהן 
                "filteredMobileNos4": "+972537893718", //ירדנה
                "filteredMobileNos5": "+972537221936", //מתן פינקר
                "filteredMobileNos6": "+972505312062", //אייל קאופמן 
                "filteredMobileNos7": "+972542244103", //רון ליבנה 
                "filteredMobileNos8": "+972545876156", //רון ליבנה 
                "pastCollectDays": "9",
                "PROXY_SERVER": "",//tailscale-bridge:1055
                "APP_REPLICAS": "1",
                "REPLICA_SLOT": "1"
            },
            "presentation": {
                "hidden": false,
                "group": "refereeX-pwa",
                "order": 4
            }
        },        
