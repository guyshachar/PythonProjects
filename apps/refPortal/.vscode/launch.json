{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "RefPortalGateway",
            "type": "debugpy",
            "request": "launch",
            "program": "rpGw/refPortalGateway.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "envFile": "${workspaceFolder}/config/env", // <-- This line loads the env file
            "env": {
            },
            "presentation": {
                "hidden": true,
                "group": "server",
                "order": 1
            }        
        },
        {
            "name": "RefPortalGatewayDI",
            "type": "debugpy",
