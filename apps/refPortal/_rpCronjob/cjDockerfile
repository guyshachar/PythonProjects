# Use Python 3.13 slim image as base
FROM python:3.13-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    g++ \
    make \
    cmake \
    unzip \
    libcurl4-openssl-dev \
    #software-properties-common \
    fonts-liberation \
    libappindicator3-1 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    #libgdk-pixbuf2.0-0 \
    libnspr4 \
    libnss3 \
    libraqm-dev \
    pciutils \
    xdg-utils \
    tzdata \
    cron \
    supervisor \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy application code
COPY . /app/

# Create shared directory and copy shared modules
COPY shared/*.py /shared/.
COPY shared/db/ /shared/db/
COPY shared/messaging/ /shared/messaging/
COPY shared/orgRelated/ /shared/orgRelated/

# Copy newServiceArchitecture modules
RUN mkdir -p /newServiceArchitecture
COPY newServiceArchitecture/*.py /newServiceArchitecture/.

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install additional dependencies specific to cronjob client
RUN pip install --no-cache-dir \
    schedule \
    psutil

# Set timezone
ENV TZ=Asia/Jerusalem
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Set environment variables
ENV PYTHONPATH="/app:/shared:/newServiceArchitecture"
ENV PYTHONUNBUFFERED=1

# Create necessary directories
RUN mkdir -p /var/log/cronjob \
    && mkdir -p /var/run/supervisor \
    && mkdir -p /etc/supervisor/conf.d

# Copy supervisor configuration
COPY ./supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Create startup script
COPY ./start.sh /start.sh
RUN chmod +x /start.sh

# Expose port for health checks (optional)
EXPOSE 8080

# Use supervisor to manage the cronjob service
CMD ["/start.sh"]
