# Use the official Python image from the Docker Hub
FROM python:3.13-slim

# Set the working directory in the container
WORKDIR /app

# Copy the requirements file into the container
COPY rpMonitor/requirements.txt .

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt 

# Copy the script into the container
RUN mkdir -p /rpMonitor
RUN mkdir -p /shared
WORKDIR /app/rpMonitor
COPY /rpMonitor/*.py .
WORKDIR /app/shared
COPY /shared/*.py .
WORKDIR /app

# Define entrypoint to start Tailscale and your app
# Start Tailscale and your Python script
ENV BUILD_DATE=202502170048
ENV logLevel=INFO
ENV monitor_interval=5
ENV timeout_seconds=30
ENV restart_seconds=15
ENV servicePrefix=refportal

# Command to run the script
CMD ["python", "rpMonitor/refPortalMonitor.py"]