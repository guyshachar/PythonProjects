# Cloudflare API Configuration Template
# Copy this file to config.env and fill in your actual values

# Your Cloudflare Zone ID (found in Cloudflare dashboard under domain overview)
CLOUDFLARE_ZONE_ID="your_zone_id_here"

# Your Cloudflare API Token (create one with Zone:DNS:Edit permissions)
CLOUDFLARE_API_TOKEN="your_api_token_here"

# Your Cloudflare account email
CLOUDFLARE_EMAIL="admin@refereex.com"

# Domain for SSL certificate
DOMAIN="ha.refereex.com"

# Home Assistant SSL configuration (optional - update if different)
HA_SSL_DIR="/opt/homeassistant/config/ssl"
HA_CONTAINER_NAME="homeassistant"
