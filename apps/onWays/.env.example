# Copy to .env and fill in values before running.

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── WAHA (Primary Channel) ───────────────────────────────────────────────────
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=changeme

# ── Meta Cloud API (Shadow Channel) ──────────────────────────────────────────
META_PHONE_NUMBER_ID=123456789012345
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxx
META_API_VERSION=v19.0
META_TEMPLATE_NAME=failover_greeting
META_TEMPLATE_LANGUAGE=en_US

# Token you set in the Meta app dashboard when registering the webhook URL.
META_WEBHOOK_VERIFY_TOKEN=your_secret_verify_token

# App Secret from Meta app settings (used to verify X-Hub-Signature-256).
# Leave blank to DISABLE HMAC verification (dev only).
META_APP_SECRET=your_meta_app_secret

# ── Gateway Security ─────────────────────────────────────────────────────────
# API key the CRM sends in X-Api-Key when calling POST /v1/messages.
# Leave blank to DISABLE enforcement (dev only).
GATEWAY_API_KEY=changeme_strong_key

# ── CRM Forwarding ───────────────────────────────────────────────────────────
# OnWays POSTs every normalised event here.  Leave blank to disable.
CRM_WEBHOOK_URL=https://your-crm.example.com/webhooks/whatsapp
# Optional HMAC secret for the X-Onways-Signature header on forwarded events.
CRM_WEBHOOK_SECRET=
# Number of delivery attempts before an event goes to the Redis dead-letter queue.
CRM_MAX_RETRIES=3

# ── Failover / State ─────────────────────────────────────────────────────────
# Seconds before probing WAHA for recovery after a ban. Default: 86400 (24h).
# Set to 60 in dev/staging for fast testing.
BAN_RECOVERY_SECONDS=86400

# ── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*
